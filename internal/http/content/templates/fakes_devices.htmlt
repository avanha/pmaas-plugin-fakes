<div class="entity-fakes-devices">
    <div class="note">Fake devices, for testing. What PMAAS asks of them is shown here, and they can be changed here as the real thing could be.</div>
    {{if or .Switches .Thermometers .DoorSensors .Hosts}}
        {{range .Switches}}
            <div class="fake-device fake-switch{{if .Offline}} offline{{end}}" data-name="{{.Name | html}}">
                <div class="fake-header">
                    <span class="name">{{.Name | html}}</span>
                    <span class="kind">switch</span>
                    <span class="state-badge {{.StateClass | html}}">{{.State | html}}</span>
                    {{if .Offline}}<span class="offline-badge">Offline</span>{{end}}
                </div>
                <div class="details">
                    <div>
                        <span class="label">Reported</span>
                        {{.State | html}}{{if not .LastChangeTime.IsZero}}, changed {{RelativeTime .LastChangeTime}}{{end}}
                    </div>
                    <div>
                        <span class="label">PMAAS asked for</span>
                        {{if .Commanded}}{{.Commanded | html}} {{RelativeTime .CommandedAt}}{{else}}nothing yet{{end}}
                    </div>
                </div>
                <div class="actions">
                    <button class="fake-button" data-action="report-on" {{if .Offline}}disabled{{end}}>Press: on</button>
                    <button class="fake-button" data-action="report-off" {{if .Offline}}disabled{{end}}>Press: off</button>
                    {{if .Offline}}
                        <button class="fake-button" data-action="online">Bring online</button>
                    {{else}}
                        <button class="fake-button" data-action="offline">Take offline</button>
                    {{end}}
                    {{if .IgnoreCommands}}
                        <button class="fake-button" data-action="follow-commands">Act on commands</button>
                    {{else}}
                        <button class="fake-button" data-action="ignore-commands">Ignore commands</button>
                    {{end}}
                </div>
                <div class="actions">
                    <label>Fail the next <input class="fail-count" type="number" min="0" max="1000" value="{{.FailNext}}"> commands</label>
                    <button class="fake-button" data-action="fail-next">Set</button>
                    {{if .IgnoreCommands}}<span class="mode">accepts commands but does not act on them</span>{{end}}
                </div>
                <div class="history">
                    <div class="history-label">
                        Commands
                        {{if .History}}<button class="fake-button small" data-action="clear-history">Clear</button>{{end}}
                    </div>
                    {{if .History}}
                        {{range .History}}
                            <div class="command{{if not .Accepted}} rejected{{end}}">
                                {{.At.Format "3:04:05 PM"}} asked for {{.State | html}}:
                                {{if .Accepted}}accepted{{else}}refused, {{.Result | html}}{{end}}
                            </div>
                        {{end}}
                    {{else}}
                        <div class="none">None</div>
                    {{end}}
                </div>
                <div class="action-error"></div>
            </div>
        {{end}}
        {{range .Thermometers}}
            <div class="fake-device fake-thermometer{{if .StopReporting}} stale{{end}}" data-name="{{.Name | html}}">
                <div class="fake-header">
                    <span class="name">{{.Name | html}}</span>
                    <span class="kind">thermometer</span>
                    {{if .HasData}}
                        <span class="reading">{{printf "%.1f" .Fahrenheit}}°F ({{printf "%.1f" .Celsius}}°C)</span>
                    {{else}}
                        <span class="reading">no reading</span>
                    {{end}}
                    {{if .StopReporting}}<span class="offline-badge">Not reporting</span>{{end}}
                </div>
                <div class="details">
                    <div>
                        <span class="label">Last reported</span>
                        {{RelativeTime .Reported}}
                    </div>
                </div>
                <div class="actions">
                    <label>Set to <input class="temperature" type="number" step="0.1" min="-100" max="250" value="{{printf "%.1f" .Fahrenheit}}" {{if .StopReporting}}disabled{{end}}>°F</label>
                    <button class="fake-button" data-action="set-temperature" {{if .StopReporting}}disabled{{end}}>Set</button>
                    <button class="fake-button" data-action="adjust-temperature" data-delta="-1" {{if .StopReporting}}disabled{{end}}>-1°F</button>
                    <button class="fake-button" data-action="adjust-temperature" data-delta="1" {{if .StopReporting}}disabled{{end}}>+1°F</button>
                    {{if .StopReporting}}
                        <button class="fake-button" data-action="resume-reporting">Resume reporting</button>
                    {{else}}
                        <button class="fake-button" data-action="stop-reporting">Stop reporting</button>
                    {{end}}
                </div>
                <div class="action-error"></div>
            </div>
        {{end}}
        {{range .DoorSensors}}
            <div class="fake-device fake-door{{if .Offline}} offline{{end}}" data-name="{{.Name | html}}">
                <div class="fake-header">
                    <span class="name">{{.Name | html}}</span>
                    <span class="kind">door sensor</span>
                    <span class="state-badge {{.PositionClass | html}}">{{.Position | html}}</span>
                    {{if .Offline}}<span class="offline-badge">Offline</span>{{end}}
                </div>
                <div class="details">
                    <div>
                        <span class="label">Position</span>
                        {{.Position | html}}{{if not .LastChangeTime.IsZero}}, changed {{RelativeTime .LastChangeTime}}{{end}}
                    </div>
                </div>
                <div class="actions">
                    <button class="fake-button" data-action="door-open" {{if .Offline}}disabled{{end}}>Open the door</button>
                    <button class="fake-button" data-action="door-close" {{if .Offline}}disabled{{end}}>Close the door</button>
                    {{if .Offline}}
                        <button class="fake-button" data-action="online">Bring online</button>
                    {{else}}
                        <button class="fake-button" data-action="offline">Take offline</button>
                    {{end}}
                </div>
                <div class="action-error"></div>
            </div>
        {{end}}
        {{range .Hosts}}
            <div class="fake-device fake-host{{if .Down}} offline{{end}}" data-name="{{.Name | html}}">
                <div class="fake-header">
                    <span class="name">{{.Name | html}}</span>
                    <span class="kind">host</span>
                    {{if .Down}}<span class="offline-badge">Down</span>{{else}}<span class="state-badge on">Up</span>{{end}}
                </div>
                <div class="details">
                    <div>
                        <span class="label">{{if .Down}}Down since{{else}}Up since{{end}}</span>
                        {{RelativeTime .Since}}
                    </div>
                </div>
                <div class="actions">
                    {{if .Down}}
                        <button class="fake-button" data-action="host-up">Bring up</button>
                    {{else}}
                        <button class="fake-button" data-action="host-down">Take down</button>
                    {{end}}
                </div>
                <div class="action-error"></div>
            </div>
        {{end}}
    {{else}}
        <div class="none">No fake devices are configured</div>
    {{end}}
</div>
